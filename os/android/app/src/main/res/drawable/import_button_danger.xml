<?xml version="1.0" encoding="utf-8"?>
<!-- Delete: the game's danger button (mui_loadsave.cc kDangerFill). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/import_danger_pressed" />
            <stroke android:width="1dp" android:color="@color/import_danger_text" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/import_danger" />
            <stroke android:width="1dp" android:color="@color/import_danger_border" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
