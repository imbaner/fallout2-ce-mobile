<?xml version="1.0" encoding="utf-8"?>
<!-- A window over the list of games (GamesActivity): adding a game (back
     beside it, as the game's windows), deleting one, renaming one. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/dialog_panel"
        android:layout_width="500dp"
        android:layout_height="wrap_content"
        android:background="@drawable/import_panel"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="16dp"
        android:paddingEnd="18dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/dialog_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/import_accent"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/dialog_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/import_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/dialog_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/import_text_dim"
            android:textSize="12sp"
            android:visibility="gone" />

        <EditText
            android:id="@+id/dialog_input"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/import_button"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLength="60"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textColor="@color/import_accent"
            android:textSize="15sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/dialog_buttons"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="14dp"
            android:orientation="horizontal" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/dialog_back"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/import_button"
        android:contentDescription="@string/games_back"
        android:src="@drawable/import_back"
        android:visibility="gone" />
</LinearLayout>
