<?xml version="1.0" encoding="utf-8"?>
<!-- A window over the list of games (GamesActivity): adding a game, deleting
     one, renaming one. Over the whole screen, the panel in its middle. Back
     (adding a game) as in the game's windows (mui_update.cc): phones - at the
     screen's top right, where the list's own is, the panel in the middle of
     what is left; tablets - beside the panel (`spacer` keeps the panel in
     the middle). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialog_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/dialog_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/dialog_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal">

            <Space
                android:id="@+id/dialog_spacer"
                android:layout_width="60dp"
                android:layout_height="1dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/dialog_panel"
                android:layout_width="500dp"
                android:layout_height="wrap_content"
                android:background="@drawable/import_panel"
                android:clickable="true"
                android:focusable="false"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="16dp"
                android:paddingEnd="18dp"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/dialog_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/import_accent"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/dialog_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/import_text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/dialog_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/import_text_dim"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <EditText
                    android:id="@+id/dialog_input"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/import_button"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLength="60"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:textColor="@color/import_accent"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/dialog_buttons"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/dialog_back"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/import_button"
                android:contentDescription="@string/games_back"
                android:src="@drawable/import_back"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
